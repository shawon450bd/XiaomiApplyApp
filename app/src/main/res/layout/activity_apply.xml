<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:padding="8dp"
    tools:context=".ApplyActivity">

    <TextView
        android:id="@+id/tvMadeBy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/made_by"
        android:textColor="#FF00E5FF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:letterSpacing="0.15"
        android:shadowColor="#FF00B0FF"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="12"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/tokenLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_bg"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvMadeBy"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etToken1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/token1_hint"
                android:inputType="text"
                android:textColor="@color/white"
                android:textColorHint="#88FFFFFF"
                android:textSize="12sp"
                android:backgroundTint="@color/accent"
                android:maxLines="1" />

            <Button
                android:id="@+id/btnPaste1"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/paste"
                android:textSize="11sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <EditText
                android:id="@+id/etToken2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/token2_hint"
                android:inputType="text"
                android:textColor="@color/white"
                android:textColorHint="#88FFFFFF"
                android:textSize="12sp"
                android:backgroundTint="@color/accent"
                android:maxLines="1" />

            <Button
                android:id="@+id/btnPaste2"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/paste"
                android:textSize="11sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tokenLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnRun"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/run"
            android:textStyle="bold"
            android:textSize="16sp"
            android:backgroundTint="@color/accent"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnTelegram"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/telegram"
            android:textStyle="bold"
            android:textSize="14sp"
            android:backgroundTint="@color/telegram_blue" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/slotsGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="2"
        android:rowCount="2"
        android:alignmentMode="alignBounds"
        android:useDefaultMargins="true"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnRow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="@drawable/slot_bg"
            android:padding="4dp">
            <TextView
                android:id="@+id/tvSlot1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:text="@string/slot1" />
        </ScrollView>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="@drawable/slot_bg"
            android:padding="4dp">
            <TextView
                android:id="@+id/tvSlot2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:text="@string/slot2" />
        </ScrollView>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="@drawable/slot_bg"
            android:padding="4dp">
            <TextView
                android:id="@+id/tvSlot3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:text="@string/slot3" />
        </ScrollView>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:background="@drawable/slot_bg"
            android:padding="4dp">
            <TextView
                android:id="@+id/tvSlot4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:text="@string/slot4" />
        </ScrollView>
    </GridLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
